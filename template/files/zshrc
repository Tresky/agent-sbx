# Interactive shells only. Everything a non-interactive shell needs is in
# ~/.zshenv; do not move tool setup here.
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# oh-my-zsh, from the core of the template. `sbx new` writes this file into the
# sandboxes of an older template too, and those have no ~/.oh-my-zsh.
if [[ -s "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  # A template rebuild updates oh-my-zsh. Its own update check can stop a new
  # shell with a question.
  zstyle ':omz:update' mode disabled
  ZSH_THEME="robbyrussell"
  plugins=(git)
  source "$ZSH/oh-my-zsh.sh"
  # The theme does not show the host. The name tells you which sandbox this is.
  PROMPT="%F{cyan}%m%f $PROMPT"
else
  autoload -Uz compinit && compinit -C
  PROMPT='%F{cyan}%m%f %F{blue}%~%f %# '
fi
setopt share_history hist_ignore_dups auto_cd
bindkey -e

# Switches node when a directory has an .nvmrc. mise's shims need no hook: they
# read the version files at each call. Only here: a hook on every `cd` is too
# slow for tool calls.
autoload -U add-zsh-hook
_sbx_nvmrc() { [[ -f .nvmrc ]] && nvm use --silent >/dev/null 2>&1; }
add-zsh-hook chpwd _sbx_nvmrc

command -v direnv >/dev/null && eval "$(direnv hook zsh)"
# With no terminal, fzf's script prints "can't change option: zle".
[[ -t 0 ]] && command -v fzf >/dev/null && source <(fzf --zsh 2>/dev/null)

# A shell that STARTS inside a project has had no `cd`, so no hook has chosen
# its node (or, on a template built with rvm, its ruby and gemset). One `cd .`
# fires every chpwd hook for the directory the shell began in.
cd .
